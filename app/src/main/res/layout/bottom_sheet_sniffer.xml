<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvSnifferTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IDM Medya Yakalayıcı"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSnifferSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Yakalanan video, ses ve dosyaları IDM veya harici oynatıcıya aktarın."
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSniffedMedia"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvSnifferEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="28dp"
        android:text="Henüz yakalanan bir medya veya dosya yok.
Sayfadaki videoyu oynattığınızda bağlantılar burada görünür."
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearSniffer"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Listeyi Temizle" />

</LinearLayout>
